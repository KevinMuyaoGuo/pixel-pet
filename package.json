{
  "name": "pixel-pet",
  "version": "0.7.0",
  "productName": "Pixel Pet",
  "description": "macOS pixel desktop companion",
  "author": "Kevin Muyao Guo",
  "private": true,
  "type": "module",
  "main": "dist-electron/main.js",
  "scripts": {
    "predev": "tsc -p electron/tsconfig.json",
    "dev": "concurrently -k \"vite --host 127.0.0.1\" \"wait-on tcp:127.0.0.1:5173 && electron .\"",
    "build": "tsc -b && vite build && tsc -p electron/tsconfig.json",
    "start": "electron .",
    "build:icons": "swift scripts/generate-icons.swift",
    "package:mac": "npm run build && node scripts/package-mac.mjs",
    "test": "tsc -p electron/tsconfig.json && node --test tests/*.test.mjs",
    "test:electron": "npm run build && PIXEL_PET_DEV_URL=http://127.0.0.1:5178 electron tests/electron-smoke.cjs"
  },
  "dependencies": {
    "@vitejs/plugin-react": "latest",
    "react": "latest",
    "react-dom": "latest",
    "vite": "latest"
  },
  "devDependencies": {
    "@types/node": "latest",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "concurrently": "latest",
    "electron-builder": "^26.18.0",
    "typescript": "latest",
    "wait-on": "latest",
    "electron": "latest"
  },
  "build": {
    "appId": "com.kevinmuyaoguo.pixelpet",
    "productName": "Pixel Pet",
    "directories": {
      "output": "release",
      "buildResources": "assets"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "assets/PixelPetTemplate.png",
        "to": "PixelPetTemplate.png"
      },
      {
        "from": "assets/PixelPetTemplate@2x.png",
        "to": "PixelPetTemplate@2x.png"
      }
    ],
    "npmRebuild": false,
    "mac": {
      "category": "public.app-category.utilities",
      "icon": "assets/pixel-pet.icns",
      "target": [
        "dmg"
      ],
      "identity": null,
      "hardenedRuntime": false,
      "notarize": false
    },
    "forceCodeSigning": false
  }
}
